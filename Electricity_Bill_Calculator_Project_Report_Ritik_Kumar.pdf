q q .780392 .823529 .870588 RG .5 w 56.69291 796.5354 m 538.5827 796.5354 l S .333333 .333333 .333333 rg BT 9.6 TL/F1 8 Tf 1 0 0 1 56.69291 807.874 Tm (RUNGTA INTERNATIONAL SKILLS UNIVERSITY)Tj T* ET 56.69291 42.51969 m 538.5827 42.51969 l S BT 1 0 0 1 293.1898 25.51181 Tm T* ET Q q 1 0 0 1 62.69291 749.6929 cm .090196 .211765 .364706 rg BT 21 TL/F2 17 Tf 1 0 0 1 0 4 Tm (8. IMPLEMENTATION)Tj T* ET Q q 1 0 0 1 62.69291 720.6929 cm .090196 .211765 .364706 rg BT 15 TL/F2 12 Tf 1 0 0 1 0 3 Tm (Program structure)Tj T* ET Q q 1 0 0 1 62.69291 672.6929 cm 0 0 0 rg BT 4.027783 Tw 14 TL/F1 9.6 Tf 1 0 0 1 0 32.4 Tm (The project is implemented as one Python file, for example electricity_bill.py. The file contains the)Tj T* .556012 Tw (energy-charge function, the bill-generation function and the main section that accepts and validates input. No)Tj T* 0 Tw (external module is required.)Tj T* ET Q q 1 0 0 1 62.69291 649.6929 cm .090196 .211765 .364706 rg BT 15 TL/F2 12 Tf 1 0 0 1 0 3 Tm (Complete Python program)Tj T* ET Q q 1 0 0 1 62.69291 266.4929 cm 0 0 0 rg BT 9.2 TL/F4 7.2 Tf 1 0 0 1 7 370 Tm (def calculate_energy_charge\(units\):)Tj T* (    if units <= 100:)Tj T* (        energy = units * 3)Tj T* (    elif units <= 200:)Tj T* (        energy = \(100 * 3\) + \(units - 100\) * 5)Tj T* (    else:)Tj T* (        energy = \(100 * 3\) + \(100 * 5\) + \(units - 200\) * 8)Tj T* T* (    return energy)Tj T* T* T* (def generate_bill\(name, units\):)Tj T* (    energy = calculate_energy_charge\(units\))Tj T* (    fixed = 50)Tj T* (    tax = \(energy + fixed\) * 5 / 100)Tj T* (    total = energy + fixed + tax)Tj T* T* (    print\("\\n========== ELECTRICITY BILL =========="\))Tj T* (    print\("Consumer Name :", name\))Tj T* (    print\("Units Consumed:", units\))Tj T* (    print\("--------------------------------------"\))Tj T* (    print\("Energy Charge : Rs.", format\(energy, ".2f"\)\))Tj T* (    print\("Fixed Charge  : Rs.", format\(fixed, ".2f"\)\))Tj T* (    print\("Tax \(5%\)      : Rs.", format\(tax, ".2f"\)\))Tj T* (    print\("--------------------------------------"\))Tj T* (    print\("Total Bill    : Rs.", format\(total, ".2f"\)\))Tj T* (    print\("======================================"\))Tj T* T* T* (name = input\("Enter consumer name: "\))Tj T* T* (try:)Tj T* (    units = int\(input\("Enter units consumed: "\)\))Tj T* T* (    if units < 0:)Tj T* (        print\("Invalid units. Enter a non-negative number."\))Tj T* (    else:)Tj T* (        generate_bill\(name, units\))Tj T* T* (except ValueError:)Tj T* (    print\("Invalid units. Enter a non-negative number."\))Tj T* ET Q Q

